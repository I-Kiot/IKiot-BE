# Copy to .env and fill in. Values here are placeholders, never real secrets.
#
# `validateEnv()` (src/common/config/env.ts) runs before the app accepts traffic: the
# REQUIRED block below aborts the boot if unset, the OPTIONAL block only logs a warning
# saying which feature is switched off. That split is the contract - if you add a variable,
# add it there too, or nobody will find out it is missing until the feature is used.

# ─── Required ────────────────────────────────────────────────────────────────

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ikiot_db

# Signs and verifies access tokens. ACCESS_TOKEN_SECRET wins if both are set - that is the
# precedence iKiotMS-BE used and the name the running production environment already has.
ACCESS_TOKEN_SECRET=
JWT_SECRET=change-me-to-a-long-random-string

# ─── Required in production only ─────────────────────────────────────────────

# Comma-separated allow-list for both HTTP and Socket.IO. Unset means "reflect any origin",
# which with credentials enabled lets any site on the internet make authenticated calls -
# fine locally, refused at boot when NODE_ENV=production. FRONTEND_URL is read as a
# fallback for the same purpose.
CORS_ORIGIN=https://app.example.com
FRONTEND_URL=

# Number of proxy hops in front of the app (Render: 1). Unset means no proxy. Without it
# `request.ip` is the load balancer's and X-Forwarded-For is unvalidated client input -
# which AuditInterceptor records, so anyone could forge the IP in their own audit trail.
TRUST_PROXY=1

# ─── Optional: each one switches a feature off when missing ──────────────────

# Refresh-token sessions and OTP storage. Missing = sessions degrade (see RedisService).
REDIS_URL=redis://localhost:6379
# Separate key for refresh tokens; falls back to the access-token secret.
REFRESH_TOKEN_SECRET=

# File uploads (Cloudinary). Missing = POST /uploads is disabled.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Outgoing mail: subscription reminders and operator announcements.
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# Platform's own SePay account - how tenants pay iKiot for a plan. Note this is separate
# from each shop's own SePay key, which lives on the Tenant row, not here.
SEPAY_API_KEY=
SEPAY_ACCOUNT_NUMBER=
SEPAY_BANK_NAME=
SEPAY_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=

# Vietnamese public-holiday sync (monthly cron). Missing = the sync is skipped.
GOOGLE_VN_HOLIDAY_CALENDAR_ID=
GOOGLE_CALENDAR_API_KEY=

# Firebase Admin - used by two features: POST /auth/firebase-login (verifies a Google ID
# token) and FCM push (the third leg of NotificationService.notify(), for users whose app
# is closed). All three vars are needed; missing = both disabled, nothing else breaks.
# FIREBASE_PRIVATE_KEY keeps its \n escapes on one line - the service un-escapes them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI assistant. Missing = POST /ai/chat answers 503.
GEMINI_API_KEY=
# Overrides the model; read at call time, not at import.
GEMINI_MODEL=

# SMS OTP (eSMS). Missing = OTP codes are logged instead of sent, dev-only.
ESMS_API_KEY=248B226E8DB77DB3AD8022BB348171
ESMS_SECRET_KEY=20E95925BCDF5028F92484EBD8D377
ESMS_BRANDNAME=Baotrixemay

# Defaults to 3000.
PORT=3000
NODE_ENV=development
