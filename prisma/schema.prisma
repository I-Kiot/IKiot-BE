  payAfterPeriodEndDays      Int      @default(1) @map("pay_after_period_end_days")
  autoGenerate               Boolean  @default(false) @map("auto_generate")
  standardWorkingDays        Int      @default(26) @map("standard_working_days")
  standardWorkingHoursPerDay Int      @default(8) @map("standard_working_hours_per_day")
  weekendDays                Int[]    @default([0]) @map("weekend_days")
