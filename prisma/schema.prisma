// iKiotMS schema. uuid PKs, snake_case via @map; enum-like columns are String (values in comments).
// Core rules: available = stock - reserved; every stock change writes one InventoryTransaction;
// stock is added as soon as an import is received, reserved on confirmation and deducted when packed.
// Stock is held in InventoryLot rows that keep their source (supplier / workshop) and unit cost, so the
// cost of every unit sold - and the margin per source - is known: Σ lot.remaining = inventories.stock.
// Every ledger row moves exactly one lot; an outbound move that spans two lots writes two rows.
// Goods are checked by the person in charge whenever they move: an import / transfer is checked line
// by line on receive (receivedQuantity / defectQuantity), a transfer when it is shipped (shippedBy),
// and every sale - takeaway included - when its fulfillment is verified (verifiedBy).
// Location.type is BRANCH | WAREHOUSE; a Branch/Warehouse shares its Location's id.

// SQL-only constraints (keep them when editing a generated migration):
//   - locations: CHECK locations_type_known (location_type IN ('BRANCH', 'WAREHOUSE'))
//   - branches / warehouses: CHECK (id = location_id)
//   - users: email / identification id unique per tenant among non-DELETED rows
//   - holidays: one PUBLIC_HOLIDAY per tenant per date (partial, branch_id IS NULL)
//   - cash_drawer_sessions: one OPEN session per branch (partial)
//   - working_schedules: unique live slot (partial)
//   - inventories: CHECK (stock >= 0 AND reserved >= 0 AND reserved <= stock)
//   - order_items: CHECK (quantity > 0 AND returned_quantity BETWEEN 0 AND quantity)
//   - stock_reservations, production_request_items, order_return_items: CHECK (quantity > 0)
//   - production_request_items: CHECK (received_quantity >= 0)
//   - stock_movement_request_items: CHECK (defect_quantity BETWEEN 0 AND COALESCE(received_quantity, 0))
//   - stock_movement_requests: CHECK ((movement_type = 'IMPORT') = (import_source IS NOT NULL))
//   - inventory_lots: CHECK (received_quantity > 0 AND remaining_quantity BETWEEN 0 AND received_quantity)
//   - orders: CHECK (status IN ('DRAFT', 'PENDING_CONFIRMATION') OR assignee_id IS NOT NULL)
//   - fulfillment_items: CHECK (qty_packed <= qty_picked AND qty_picked <= quantity)
//   - payments: CHECK (amount > 0)
//   - invoices: one live SALE invoice per order (partial, type = 'SALE' AND status <> 'CANCELLED')

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────────────────
// A. Foundation & platform
// ─────────────────────────────────────────────────────────────────────────

model Tenant {
  id            String  @id @default(uuid())
  name          String
  tenantOwnerId String? @map("tenant_owner_id")
  tenantOwner   User?   @relation("TenantOwner", fields: [tenantOwnerId], references: [id])
  status        String  @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED
  phoneNumber   String? @map("phone_number")
  mainAddress   String? @map("main_address")
  taxNumber     String? @map("tax_number")

  bankingAccountNumber      String? @map("banking_account_number")
  bankingBankName           String? @map("banking_bank_name")
  bankingAccountName        String? @map("banking_account_name")
  bankingSepayWebhookApiKey String? @map("banking_sepay_webhook_api_key") // secret - never select by default

  invoiceAutoIssueOn String? @map("invoice_auto_issue_on") // null = off | PAID | COMPLETED

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  users                   User[]                     @relation("TenantUsers")
  roles                   Role[]
  subscriptions           Subscription[]
  subscriptionInvoices    SubscriptionInvoice[]
  locations               Location[]
  branches                Branch[]
  warehouses              Warehouse[]
  brands                  Brand[]
  categories              Category[]
  suppliers               Supplier[]
  customers               Customer[]
  products                Product[]
  productItems            ProductItem[]
  inventories             Inventory[]
  inventoryTransactions   InventoryTransaction[]
  inventoryLots           InventoryLot[]
  stockMovementRequests   StockMovementRequest[]
  shiftTemplates          ShiftTemplate[]
  workingSchedules        WorkingSchedule[]
  holidays                Holiday[]
  salesChannels           SalesChannel[]
  channelProductMappings  ChannelProductMapping[]
  orders                  Order[]
  orderItemCustomizations OrderItemCustomization[]
  stockReservations       StockReservation[]
  productionRequests      ProductionRequest[]
  orderReturns            OrderReturn[]
  promotions              Promotion[]
  promotionLogs           PromotionLog[]
  cashDrawerSessions      CashDrawerSession[]
  cashFlows               CashFlow[]
  notifications           Notification[]
  targetedByNotifications NotificationTargetTenant[]
  tickets                 Ticket[]
  aiChatHistories         AIChatHistory[]
  auditLogs               AuditLog[]
  storageNodes            StorageNode[]
  skuPlacements           SkuPlacement[]
  payments                Payment[]
  fulfillments            Fulfillment[]
  fulfillmentPackages     FulfillmentPackage[]
  shipments               Shipment[]
  operationEvents         OperationEvent[]
  vouchers                Voucher[]
  voucherCodes            VoucherCode[]
  invoices                Invoice[]

  @@map("tenants")
}

model User {
  id             String    @id @default(uuid())
  tenantId       String?   @map("tenant_id") // null = platform account (systemRole = ADMIN)
  tenant         Tenant?   @relation("TenantUsers", fields: [tenantId], references: [id])
  email          String?
  password       String?
  phoneNumber    String    @map("phone_number") // platform-wide login handle
  systemRole     String    @default("STAFF") @map("system_role") // ADMIN | TENANT_OWNER | CUSTOMER | STAFF
  roleId         String?   @map("role_id") // tenant-defined role, STAFF only
  role           Role?     @relation(fields: [roleId], references: [id])
  status         String    @default("ACTIVE") // ACTIVE | INACTIVE | SUSPENDED | DELETED
  createdById    String?   @map("created_by")
  createdBy      User?     @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers   User[]    @relation("UserCreatedBy")
  deletedById    String?   @map("deleted_by")
  deletedBy      User?     @relation("UserDeletedBy", fields: [deletedById], references: [id])
  deletedUsers   User[]    @relation("UserDeletedBy")
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(6)
  deletionReason String?   @map("deletion_reason")
  lastLogin      DateTime? @map("last_login") @db.Timestamptz(6)
  hireDate       DateTime? @map("hire_date") @db.Timestamptz(6)
  locationId     String?   @map("location_id")
  location       Location? @relation(fields: [locationId], references: [id])
  accountNote    String?   @map("account_note")

  profileFirstName        String?   @map("profile_first_name")
  profileLastName         String?   @map("profile_last_name")
  profileAvatarUrl        String?   @map("profile_avatar_url")
  profileDob              DateTime? @map("profile_dob") @db.Timestamptz(6)
  profileTaxNumber        String?   @map("profile_tax_number")
  profileIdentificationId String?   @map("profile_identification_id")
  profileAddress          String?   @map("profile_address")
  profileGender           String?   @map("profile_gender") // MALE | FEMALE | OTHER

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  fcmTokens                   UserFcmToken[]
  ownedTenants                Tenant[]                 @relation("TenantOwner")
  subscriptionChanges         SubscriptionHistoryLog[] @relation("SubscriptionHistoryChangedBy")
  managedLocations            Location[]               @relation("LocationManager")
  managedWorkingSchedules     WorkingSchedule[]        @relation("WorkingScheduleManagedBy")
  createdWorkingSchedules     WorkingSchedule[]        @relation("WorkingScheduleCreatedBy")
  scheduleAssignments         WorkingScheduleUser[]
  ordersCreated               Order[]                  @relation("OrderCreatedBy")
  ordersAssigned              Order[]                  @relation("OrderAssignee")
  ordersConfirmed             Order[]                  @relation("OrderConfirmedBy")
  productionRequestsCreated   ProductionRequest[]      @relation("ProductionRequestCreatedBy")
  productionRequestsUpdated   ProductionRequest[]      @relation("ProductionRequestStatusUpdatedBy")
  orderReturnsCreated         OrderReturn[]            @relation("OrderReturnCreatedBy")
  orderReturnsInspected       OrderReturn[]            @relation("OrderReturnInspectedBy")
  cashDrawerSessionsOpened    CashDrawerSession[]      @relation("CashDrawerOpenedBy")
  cashDrawerSessionsCurrent   CashDrawerSession[]      @relation("CashDrawerCurrentStaff")
  cashDrawerShiftLogsAsStaff  CashDrawerShiftLog[]     @relation("ShiftLogStaff")
  cashDrawerShiftLogsAsNext   CashDrawerShiftLog[]     @relation("ShiftLogNextStaff")
  cashDrawerFinalizedSessions CashDrawerSession[]      @relation("CashDrawerFinalLogManager")
  cashFlowsCreated            CashFlow[]
  promotionLogsCreated        PromotionLog[]
  notificationsReceived       Notification[]           @relation("NotificationRecipient")
  notificationsCreated        Notification[]           @relation("NotificationCreatedBy")
  ticketsCreated              Ticket[]
  ticketMessages              TicketMessage[]
  aiChatHistories             AIChatHistory[]
  auditLogs                   AuditLog[]
  inventoryTransactions       InventoryTransaction[]
  stockMovementsCreated       StockMovementRequest[]   @relation("StockMovementCreatedBy")
  stockMovementsShipped       StockMovementRequest[]   @relation("StockMovementShippedBy")
  stockMovementsReceived      StockMovementRequest[]   @relation("StockMovementReceivedBy")
  stockMovementsApproved      StockMovementRequest[]   @relation("StockMovementApprovedBy")
  fulfillmentsAssigned        Fulfillment[]            @relation("FulfillmentAssignee")
  fulfillmentsVerified        Fulfillment[]            @relation("FulfillmentVerifiedBy")
  packagesPacked              FulfillmentPackage[]
  shipmentsDriven             Shipment[]               @relation("ShipmentDriver")
  shipmentEventsCreated       ShipmentEvent[]
  operationEvents             OperationEvent[]
  paymentsCreated             Payment[]                @relation("PaymentCreatedBy")
  paymentsCollected           Payment[]                @relation("PaymentCollectedBy")
  invoicesCreated             Invoice[]

  @@map("users")
}

/// STAFF only; ADMIN / TENANT_OWNER are always full-access.
model Role {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  permissions RolePermission[]
  users       User[]

  @@unique([tenantId, name])
  @@map("roles")
}

model RolePermission {
  roleId   String            @map("role_id")
  role     Role              @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  action   String
  catalog  PermissionCatalog @relation(fields: [resource, action], references: [resource, action])

  @@id([roleId, resource, action])
  @@map("role_permissions")
}

model PermissionCatalog {
  resource String
  action   String
  label    String?

  rolePermissions RolePermission[]

  @@id([resource, action])
  @@map("permission_catalog")
}

model UserFcmToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([token])
  @@map("user_fcm_tokens")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id])
  userEmail  String?  @map("user_email")
  userName   String?  @map("user_name")
  userRole   String?  @map("user_role")
  action     String
  resource   String?
  details    String?
  tenantId   String?  @map("tenant_id")
  tenant     Tenant?  @relation(fields: [tenantId], references: [id])
  tenantName String?  @map("tenant_name")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// B. Access & billing
// ─────────────────────────────────────────────────────────────────────────

model Plan {
  id              String   @id @default(uuid())
  planName        String   @map("plan_name")
  planCode        String   @unique @map("plan_code")
  price           Decimal  @db.Decimal(12, 2)
  billingCycle    String   @default("NONE") @map("billing_cycle") // MONTHLY | YEARLY | NONE
  maxBranches     Int      @map("max_branches") // -1 = unlimited (same for the three below)
  maxWarehouses   Int      @map("max_warehouses")
  maxUsers        Int      @map("max_users")
  maxProducts     Int      @map("max_products")
  trialDays       Int      @map("trial_days")
  features        String[] @default([])
  description     String   @default("")
  displayFeatures String[] @default([]) @map("display_features")
  isPopular       Boolean  @default(false) @map("is_popular")
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscriptions        Subscription[]
  subscriptionInvoices SubscriptionInvoice[]
  historyFrom          SubscriptionHistoryLog[] @relation("SubscriptionHistoryFromPlan")
  historyTo            SubscriptionHistoryLog[] @relation("SubscriptionHistoryToPlan")

  @@map("plans")
}

model Subscription {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  planId       String    @map("plan_id")
  plan         Plan      @relation(fields: [planId], references: [id])
  status       String    @default("TRIAL") // TRIAL | ACTIVE | EXPIRED | PAST_DUE | CANCELLED
  startDate    DateTime  @map("start_date") @db.Timestamptz(6)
  endDate      DateTime  @map("end_date") @db.Timestamptz(6)
  trialEndDate DateTime? @map("trial_end_date") @db.Timestamptz(6)
  autoRenew    Boolean   @default(true) @map("auto_renew")
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelReason String?   @map("cancel_reason")

  quotaSnapshotMaxBranches   Int? @map("quota_snapshot_max_branches")
  quotaSnapshotMaxWarehouses Int? @map("quota_snapshot_max_warehouses")
  quotaSnapshotMaxUsers      Int? @map("quota_snapshot_max_users")
  quotaSnapshotMaxProducts   Int? @map("quota_snapshot_max_products")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  invoices    SubscriptionInvoice[]
  historyLogs SubscriptionHistoryLog[]

  @@map("subscriptions")
}

model SubscriptionHistoryLog {
  id             String       @id @default(uuid())
  subscriptionId String       @map("subscription_id")
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event          String? // CREATED | UPGRADED | RENEWED | CANCELLED
  fromPlanId     String?      @map("from_plan_id")
  fromPlan       Plan?        @relation("SubscriptionHistoryFromPlan", fields: [fromPlanId], references: [id])
  toPlanId       String?      @map("to_plan_id")
  toPlan         Plan?        @relation("SubscriptionHistoryToPlan", fields: [toPlanId], references: [id])
  changedAt      DateTime?    @map("changed_at") @db.Timestamptz(6)
  changedById    String?      @map("changed_by")
  changedBy      User?        @relation("SubscriptionHistoryChangedBy", fields: [changedById], references: [id])
  note           String?

  @@map("subscription_history_logs")
}

model SubscriptionInvoice {
  id                 String       @id @default(uuid())
  subscriptionId     String       @map("subscription_id")
  subscription       Subscription @relation(fields: [subscriptionId], references: [id])
  tenantId           String       @map("tenant_id")
  tenant             Tenant       @relation(fields: [tenantId], references: [id])
  planId             String       @map("plan_id")
  plan               Plan         @relation(fields: [planId], references: [id])
  amount             Decimal      @db.Decimal(12, 2)
  currency           String       @default("VND") // VND | USD
  status             String       @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  billingPeriodStart DateTime     @map("billing_period_start") @db.Timestamptz(6)
  billingPeriodEnd   DateTime     @map("billing_period_end") @db.Timestamptz(6)
  paidAt             DateTime?    @map("paid_at") @db.Timestamptz(6)
  paymentReference   String?      @unique @map("payment_reference")
  paymentMethod      String?      @map("payment_method") // BANK_TRANSFER | MOMO | VNPAY | SEPAY
  transactionRef     String?      @map("transaction_ref")
  invoiceUrl         String?      @map("invoice_url")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("subscription_invoices")
}

// ─────────────────────────────────────────────────────────────────────────
// C. Org & location reference data
// ─────────────────────────────────────────────────────────────────────────

model Location {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  name       String
  type       String  @map("location_type") // BRANCH | WAREHOUSE
  status     String  @default("ACTIVE") // ACTIVE | INACTIVE | DELETED
  /// false = damaged/returned-goods area (a WAREHOUSE): its stock is never available to sell.
  isSellable Boolean @default(true) @map("is_sellable")

  address     String?
  phoneNumber String[] @map("phone_number")
  email       String?

  managerId String? @map("manager_id")
  manager   User?   @relation("LocationManager", fields: [managerId], references: [id])

  defaultFulfillmentLocationId String?    @map("default_fulfillment_location_id")
  defaultFulfillmentLocation   Location?  @relation("LocationDefaultFulfillment", fields: [defaultFulfillmentLocationId], references: [id])
  servedLocations              Location[] @relation("LocationDefaultFulfillment")

  // Where this location's damaged / returned-broken goods go (a location with isSellable = false)
  damagedLocationId String?    @map("damaged_location_id")
  damagedLocation   Location?  @relation("LocationDamaged", fields: [damagedLocationId], references: [id])
  damagedFor        Location[] @relation("LocationDamaged")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branch    Branch?
  warehouse Warehouse?

  users                 User[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]
  inventoryLots         InventoryLot[]
  stockMovementsFrom    StockMovementRequest[]     @relation("StockMovementFromLocation")
  stockMovementsTo      StockMovementRequest[]     @relation("StockMovementToLocation")
  cashFlows             CashFlow[]
  payments              Payment[]
  workingSchedules      WorkingSchedule[]
  storageNodes          StorageNode[]
  fulfillments          Fulfillment[]
  operationEvents       OperationEvent[]
  stockReservations     StockReservation[]
  productionRequests    ProductionRequest[]
  orderItemsSourced     OrderItem[]                @relation("OrderItemSourceLocation")
  orderReturnItems      OrderReturnItem[]
  importDefects         StockMovementRequestItem[] @relation("ImportDefectLocation")
  salesChannels         SalesChannel[]

  @@index([tenantId, type])
  @@map("locations")
}

model Branch {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  locationId String   @unique @map("location_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  holidays           Holiday[]
  orders             Order[]
  promotions         PromotionBranch[]
  promotionLogs      PromotionLog[]
  cashDrawerSessions CashDrawerSession[]
  salesChannels      SalesChannel[]

  @@map("branches")
}

model Warehouse {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  locationId String   @unique @map("location_id")
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@map("warehouses")
}

model Brand {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  name        String
  description String?
  logo        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  products Product[]

  @@map("brands")
}

model Category {
  id          String     @id @default(uuid())
  tenantId    String     @map("tenant_id")
  tenant      Tenant     @relation(fields: [tenantId], references: [id])
  name        String
  parentId    String?    @map("parent_id")
  parent      Category?  @relation("CategoryParent", fields: [parentId], references: [id], onDelete: Restrict)
  children    Category[] @relation("CategoryParent")
  description String?
  imageUrl    String?    @map("image_url")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  products            Product[]
  promotionCategories PromotionCategory[]

  @@map("categories")
}

model Supplier {
  id              String   @id @default(uuid())
  tenantId        String   @map("tenant_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id])
  supplierName    String   @map("supplier_name")
  type            String   @default("GOODS") // GOODS (sells finished goods; SUPPLIER imports) | WORKSHOP (makes goods to order; production requests + WORKSHOP imports)
  contactName     String?  @map("contact_name")
  phoneNumber     String?  @map("phone_number")
  email           String?
  address         String?
  creditLimit     Decimal  @default(0) @map("credit_limit") @db.Decimal(12, 2) // <= 0 = no limit
  outstandingDebt Decimal  @default(0) @map("outstanding_debt") @db.Decimal(12, 2)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  productItems          ProductItemSupplier[]
  stockMovementRequests StockMovementRequest[]
  cashFlows             CashFlow[]
  productionRequests    ProductionRequest[]
  inventoryLots         InventoryLot[]

  @@map("suppliers")
}

model Customer {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  customerCode String?   @map("customer_code")
  name         String
  phone        String?
  email        String?
  gender       String? // MALE | FEMALE | OTHER
  address      String?
  region       String?
  dob          DateTime? @db.Timestamptz(6)
  isDeleted    Boolean   @default(false) @map("is_deleted")

  marketingConsentEmail     Boolean @default(false) @map("marketing_consent_email")
  marketingConsentZalo      Boolean @default(false) @map("marketing_consent_zalo")
  marketingConsentMessenger Boolean @default(false) @map("marketing_consent_messenger")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders        Order[]
  promotionLogs PromotionLog[]
  voucherCodes  VoucherCode[]

  @@unique([tenantId, customerCode])
  @@index([tenantId, phone])
  @@map("customers")
}

// ─────────────────────────────────────────────────────────────────────────
// D. Catalog & inventory
// ─────────────────────────────────────────────────────────────────────────

model Product {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  brandId      String?   @map("brand_id")
  brand        Brand?    @relation(fields: [brandId], references: [id])
  categoryId   String?   @map("category_id")
  category     Category? @relation(fields: [categoryId], references: [id])
  name         String
  status       String    @default("ACTIVE") // ACTIVE | INACTIVE | DISCONTINUED
  categoryName String?   @map("category_name") // denormalized
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  images       ProductImage[]
  productItems ProductItem[]

  @@map("products")
}

model ProductImage {
  id          String  @id @default(uuid())
  productId   String  @map("product_id")
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String
  isThumbnail Boolean @default(false) @map("is_thumbnail")
  position    Int     @default(0)

  @@map("product_images")
}

model ProductItem {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  productId      String   @map("product_id")
  product        Product  @relation(fields: [productId], references: [id])
  productName    String   @map("product_name") // denormalized
  productCode    String   @map("product_code")
  sku            String?
  barcode        String?
  description    String?
  retailPrice    Decimal  @map("retail_price") @db.Decimal(12, 2)
  costPrice      Decimal  @map("cost_price") @db.Decimal(12, 2)
  productSlug    String?  @map("product_slug")
  warrantyPeriod String?  @map("warranty_period")
  vat            Decimal? @db.Decimal(5, 2)

  itemType String @default("PRODUCT") @map("item_type") // PRODUCT | COMBO | SERVICE

  allowCustomization Boolean @default(false) @map("allow_customization")
  customLeadTimeDays Int?    @map("custom_lead_time_days")

  lengthCm Decimal? @map("length_cm") @db.Decimal(10, 2)
  widthCm  Decimal? @map("width_cm") @db.Decimal(10, 2)
  heightCm Decimal? @map("height_cm") @db.Decimal(10, 2)
  weightKg Decimal? @map("weight_kg") @db.Decimal(10, 3)
  volumeM3 Decimal? @map("volume_m3") @db.Decimal(10, 4)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  suppliers             ProductItemSupplier[]
  details               ProductItemDetail[]
  images                ProductItemImage[]
  inventories           Inventory[]
  inventoryTransactions InventoryTransaction[]
  inventoryLots         InventoryLot[]
  stockMovementItems    StockMovementRequestItem[]
  orderItems            OrderItem[]
  promotionProductItems PromotionProductItem[]
  packages              ProductPackage[]
  comboComponents       ComboComponent[]           @relation("ComboParent")
  partOfCombos          ComboComponent[]           @relation("ComboComponentItem")
  placements            SkuPlacement[]
  channelMappings       ChannelProductMapping[]
  productionItems       ProductionRequestItem[]

  @@unique([tenantId, sku])
  @@index([tenantId, productId])
  @@index([tenantId, productCode])
  @@index([tenantId, barcode])
  @@map("product_items")
}

model ProductItemSupplier {
  productItemId String      @map("product_item_id")
  productItem   ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)
  supplierId    String      @map("supplier_id")
  supplier      Supplier    @relation(fields: [supplierId], references: [id])
  leadTimeDays  Int?        @map("lead_time_days")

  @@id([productItemId, supplierId])
  @@map("product_item_suppliers")
}

model ProductItemDetail {
  id            String      @id @default(uuid())
  productItemId String      @map("product_item_id")
  productItem   ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)
  name          String?
  value         String?
  position      Int         @default(0)

  @@map("product_item_details")
}

model ProductItemImage {
  id            String      @id @default(uuid())
  productItemId String      @map("product_item_id")
  productItem   ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)
  url           String
  isThumbnail   Boolean     @default(false) @map("is_thumbnail")
  position      Int         @default(0)

  @@map("product_item_images")
}

model ProductPackage {
  id            String      @id @default(uuid())
  productItemId String      @map("product_item_id")
  productItem   ProductItem @relation(fields: [productItemId], references: [id], onDelete: Cascade)
  position      Int // 1..n ("kiện 1/3")
  name          String?
  barcode       String?
  lengthCm      Decimal?    @map("length_cm") @db.Decimal(10, 2)
  widthCm       Decimal?    @map("width_cm") @db.Decimal(10, 2)
  heightCm      Decimal?    @map("height_cm") @db.Decimal(10, 2)
  weightKg      Decimal?    @map("weight_kg") @db.Decimal(10, 3)

  packedPackages FulfillmentPackage[]

  @@unique([productItemId, position])
  @@map("product_packages")
}

model ComboComponent {
  comboItemId     String      @map("combo_item_id")
  comboItem       ProductItem @relation("ComboParent", fields: [comboItemId], references: [id], onDelete: Cascade)
  componentItemId String      @map("component_item_id")
  componentItem   ProductItem @relation("ComboComponentItem", fields: [componentItemId], references: [id])
  quantity        Int         @default(1)

  @@id([comboItemId, componentItemId])
  @@map("combo_components")
}

model Inventory {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id])

  productItemId String      @map("product_item_id")
  productItem   ProductItem @relation(fields: [productItemId], references: [id])

  stock     Int      @default(0)
  reserved  Int      @default(0) // = Σ ACTIVE StockReservation
  minStock  Int      @default(0) @map("min_stock") // 0 = no low-stock alert
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, locationId, productItemId])
  @@index([tenantId, locationId, minStock])
  @@map("inventories")
}

/// Append-only stock ledger.
model InventoryTransaction {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  locationId    String      @map("location_id")
  location      Location    @relation(fields: [locationId], references: [id])
  productItemId String      @map("product_item_id")
  productItem   ProductItem @relation(fields: [productItemId], references: [id])

  // IMPORT | TRANSFER_OUT | TRANSFER_IN | TRANSFER_LOSS | ADJUST | SALE | RETURN_GOOD | RETURN_DAMAGED
  type         String
  quantity     Int // signed: + in, - out
  balanceAfter Int      @map("balance_after")
  unitCost     Decimal? @map("unit_cost") @db.Decimal(12, 2)

  referenceType String  @map("reference_type") // STOCK_MOVEMENT | FULFILLMENT | ORDER | PRODUCTION_REQUEST | ORDER_RETURN
  referenceId   String  @map("reference_id")
  note          String?

  createdById String?  @map("created_by")
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  // The one lot this row moved. An inbound row opens it; an outbound row draws from it.
  lotId String       @map("lot_id")
  lot   InventoryLot @relation(fields: [lotId], references: [id])

  // SALE / RETURN_* rows: the order line, so cost of goods sold per line is Σ quantity × lot.unitCost
  orderItemId String?    @map("order_item_id")
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])

  @@index([tenantId, locationId, productItemId, createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_transactions")
}

/// A batch of one SKU at one location, keeping where it came from and what it cost.
/// Opened by an inbound ledger row; outbound rows draw from lots (FIFO by receivedAt, a custom
/// piece only from the lot made for its order line), one ledger row per lot touched.
model InventoryLot {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  locationId    String      @map("location_id")
  location      Location    @relation(fields: [locationId], references: [id])
  productItemId String      @map("product_item_id")
  productItem   ProductItem @relation(fields: [productItemId], references: [id])

  // Origin of the goods, carried unchanged when a lot is moved or returned:
  // SUPPLIER | WORKSHOP | ADJUSTMENT (stocktake surplus) | OPENING (stock that predates lots)
  sourceType String    @map("source_type")
  supplierId String?   @map("supplier_id") // the supplier or the workshop (SUPPLIER / WORKSHOP)
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  importItemId            String?                   @map("import_item_id") // the IMPORT line that brought it in
  importItem              StockMovementRequestItem? @relation(fields: [importItemId], references: [id])
  productionRequestItemId String?                   @map("production_request_item_id") // WORKSHOP
  productionRequestItem   ProductionRequestItem?    @relation(fields: [productionRequestItemId], references: [id])
  orderItemId             String?                   @map("order_item_id") // custom piece: only this line may consume it
  orderItem               OrderItem?                @relation("InventoryLotCustomFor", fields: [orderItemId], references: [id])

  // Split off another lot by a transfer, a customer return or a defect put-away
  parentLotId String?        @map("parent_lot_id")
  parentLot   InventoryLot?  @relation("InventoryLotParent", fields: [parentLotId], references: [id])
  childLots   InventoryLot[] @relation("InventoryLotParent")

  unitCost          Decimal  @map("unit_cost") @db.Decimal(12, 2) // import price; workshop price for WORKSHOP
  receivedQuantity  Int      @map("received_quantity")
  remainingQuantity Int      @map("remaining_quantity")
  receivedAt        DateTime @map("received_at") @db.Timestamptz(6) // FIFO key; kept from the parent lot
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  transactions InventoryTransaction[]

  @@index([tenantId, locationId, productItemId, receivedAt])
  @@index([tenantId, sourceType, supplierId])
  @@index([orderItemId])
  @@map("inventory_lots")
}

model StorageNode {
  id         String        @id @default(uuid())
  tenantId   String        @map("tenant_id")
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  locationId String        @map("location_id")
  location   Location      @relation(fields: [locationId], references: [id], onDelete: Cascade)
  parentId   String?       @map("parent_id")
  parent     StorageNode?  @relation("StorageNodeParent", fields: [parentId], references: [id], onDelete: Restrict)
  children   StorageNode[] @relation("StorageNodeParent")

  type   String // AREA | AISLE | RACK | LEVEL | BIN | DISPLAY_ZONE
  code   String // label, e.g. A-03-R2-L1-B04
  name   String?
  status String  @default("ACTIVE") // ACTIVE | INACTIVE | DELETED

  pickSequence Int? @map("pick_sequence") // walk order for pick lists

  posX     Float? @map("pos_x")
  posY     Float? @map("pos_y")
  width    Float?
  height   Float?
  rotation Float?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  placements       SkuPlacement[]
  fulfillmentItems FulfillmentItem[]

  @@unique([locationId, code])
  @@index([tenantId, locationId, type])
  @@map("storage_nodes")
}

model SkuPlacement {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  storageNodeId String      @map("storage_node_id")
  storageNode   StorageNode @relation(fields: [storageNodeId], references: [id], onDelete: Cascade)
  productItemId String      @map("product_item_id")
  productItem   ProductItem @relation(fields: [productItemId], references: [id])
  isDefault     Boolean     @default(false) @map("is_default")
  quantity      Int?
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([storageNodeId, productItemId])
  @@index([tenantId, productItemId])
  @@map("sku_placements")
}

model StockMovementRequest {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  movementType String @map("movement_type") // IMPORT | EXPORT | RETURN | ADJUST
  status       String @default("DRAFT") // DRAFT | PENDING | OPENING | CLOSED | IN_TRANSIT | RECEIVED | COMPLETED | CANCELLED

  // IMPORT only - the two receiving flows, never mixed on one document:
  //   SUPPLIER = buying finished goods from a GOODS supplier
  //   WORKSHOP = goods a WORKSHOP made; every line points at its productionRequestItem
  importSource String? @map("import_source")

  fromSupplierId String?   @map("from_supplier_id") // the supplier or the workshop; its type must match importSource
  fromSupplier   Supplier? @relation(fields: [fromSupplierId], references: [id])

  fromLocationId String?   @map("from_location_id")
  fromLocation   Location? @relation("StockMovementFromLocation", fields: [fromLocationId], references: [id])

  toLocationId String?   @map("to_location_id")
  toLocation   Location? @relation("StockMovementToLocation", fields: [toLocationId], references: [id])

  createdById  String    @map("created_by")
  createdBy    User      @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  shippedById  String?   @map("shipped_by")
  shippedBy    User?     @relation("StockMovementShippedBy", fields: [shippedById], references: [id])
  shippedAt    DateTime? @map("shipped_at") @db.Timestamptz(6)
  receivedById String?   @map("received_by")
  receivedBy   User?     @relation("StockMovementReceivedBy", fields: [receivedById], references: [id])
  receivedAt   DateTime? @map("received_at") @db.Timestamptz(6)
  approvedById String?   @map("approved_by") // ADJUST
  approvedBy   User?     @relation("StockMovementApprovedBy", fields: [approvedById], references: [id])
  approvedAt   DateTime? @map("approved_at") @db.Timestamptz(6)
  cancelledAt  DateTime? @map("cancelled_at") @db.Timestamptz(6)

  totalPrice Decimal  @default(0) @map("total_price") @db.Decimal(14, 2)
  note       String?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  details StockMovementRequestItem[]

  @@index([tenantId, fromLocationId])
  @@index([tenantId, toLocationId])
  @@index([tenantId, status])
  @@index([tenantId, movementType, importSource, fromSupplierId])
  @@map("stock_movement_requests")
}

model StockMovementRequestItem {
  id               String               @id @default(uuid())
  requestId        String               @map("request_id")
  request          StockMovementRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  productItemId    String               @map("product_item_id")
  productItem      ProductItem          @relation(fields: [productItemId], references: [id])
  quantity         Int
  importPrice      Decimal?             @map("import_price") @db.Decimal(12, 2) // IMPORT: becomes the lot's unit cost
  receivedQuantity Int?                 @map("received_quantity")
  defectQuantity   Int                  @default(0) @map("defect_quantity") // put away at defectLocation
  note             String?

  productionRequestItemId String?                @map("production_request_item_id") // required on a WORKSHOP import
  productionRequestItem   ProductionRequestItem? @relation(fields: [productionRequestItemId], references: [id])

  // Where the defective units of this line were put (defaults to the destination's damagedLocation)
  defectLocationId String?   @map("defect_location_id")
  defectLocation   Location? @relation("ImportDefectLocation", fields: [defectLocationId], references: [id])

  lots InventoryLot[]

  @@index([requestId])
  @@index([productionRequestItemId])
  @@map("stock_movement_request_items")
}

// ─────────────────────────────────────────────────────────────────────────
// E. HR: shift templates, rostering & holidays (payroll, attendance and leave are out of scope)
// ─────────────────────────────────────────────────────────────────────────

model ShiftTemplate {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String?
  startTime DateTime? @map("start_time") @db.Time
  endTime   DateTime? @map("end_time") @db.Time // may be before startTime (night shift)
  status    String    @default("ACTIVE") // ACTIVE | DELETED
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workingSchedules WorkingSchedule[]

  @@map("shift_templates")
}

model WorkingSchedule {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  locationId      String?        @map("location_id")
  location        Location?      @relation(fields: [locationId], references: [id])
  managedById     String?        @map("managed_by")
  managedBy       User?          @relation("WorkingScheduleManagedBy", fields: [managedById], references: [id])
  scheduleType    String         @default("NORMAL") @map("schedule_type") // NORMAL | OVERTIME
  shiftTemplateId String?        @map("shift_template_id")
  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  createdById     String?        @map("created_by")
  createdBy       User?          @relation("WorkingScheduleCreatedBy", fields: [createdById], references: [id])
  workDate        DateTime?      @map("work_date") @db.Date
  startAt         DateTime?      @map("start_at") @db.Timestamptz(6)
  endAt           DateTime?      @map("end_at") @db.Timestamptz(6)
  status          String         @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | DELETED
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignedUsers WorkingScheduleUser[]

  @@index([tenantId, locationId, workDate])
  @@map("working_schedules")
}

model WorkingScheduleUser {
  scheduleId String          @map("schedule_id")
  schedule   WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  userId     String          @map("user_id")
  user       User            @relation(fields: [userId], references: [id])

  @@id([scheduleId, userId])
  @@map("working_schedule_users")
}

model Holiday {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  date             DateTime @db.Date
  name             String
  type             String   @default("PUBLIC_HOLIDAY") // PUBLIC_HOLIDAY | COMPANY_HOLIDAY
  branchId         String?  @map("branch_id")
  branch           Branch?  @relation(fields: [branchId], references: [id])
  isActive         Boolean  @default(true) @map("is_active")
  source           String   @default("MANUAL") // GOOGLE_CALENDAR | MANUAL
  isManuallyEdited Boolean  @default(false) @map("is_manually_edited")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, date, branchId, type]) // branch rows only; public holidays use a partial index (see header)
  @@map("holidays")
}

// ─────────────────────────────────────────────────────────────────────────
// F. Sales: order, payment, cash
// ─────────────────────────────────────────────────────────────────────────

/// A connected marketplace shop (Shopee).
model SalesChannel {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  platform String // SHOPEE
  name     String
  shopId   String @map("shop_id") // the platform's own shop id
  status   String @default("ACTIVE") // ACTIVE | TOKEN_EXPIRED | DISCONNECTED

  // secrets: encrypted at rest, never selected by default
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at") @db.Timestamptz(6)

  branchId   String    @map("branch_id")
  branch     Branch    @relation(fields: [branchId], references: [id])
  locationId String?   @map("location_id")
  location   Location? @relation(fields: [locationId], references: [id])

  lastOrderSyncAt DateTime? @map("last_order_sync_at") @db.Timestamptz(6)
  lastSyncError   String?   @map("last_sync_error") // e.g. an order skipped for an unmapped item

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orders          Order[]
  productMappings ChannelProductMapping[]

  @@unique([platform, shopId])
  @@index([tenantId])
  @@map("sales_channels")
}

/// Platform listing/variant -> SKU. An unmapped line blocks its order from being imported.
model ChannelProductMapping {
  id              String       @id @default(uuid())
  tenantId        String       @map("tenant_id")
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  channelId       String       @map("channel_id")
  channel         SalesChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  externalItemId  String       @map("external_item_id") // Shopee item_id
  externalModelId String       @default("0") @map("external_model_id") // Shopee model_id, "0" = no variant
  externalSku     String?      @map("external_sku")
  productItemId   String       @map("product_item_id")
  productItem     ProductItem  @relation(fields: [productItemId], references: [id])
  syncStock       Boolean      @default(true) @map("sync_stock") // push available stock to the platform
  lastStockPushAt DateTime?    @map("last_stock_push_at") @db.Timestamptz(6)
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([channelId, externalItemId, externalModelId])
  @@index([tenantId, productItemId])
  @@map("channel_product_mappings")
}

model Order {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  branchId   String   @map("branch_id") // the store that sold it (not where it ships from)
  branch     Branch   @relation(fields: [branchId], references: [id])
  customerId String   @map("customer_id")
  customer   Customer @relation(fields: [customerId], references: [id])
  status     String // DRAFT | PENDING_CONFIRMATION | CONFIRMED | READY_TO_PACK | PACKED | SHIPPING | DELIVERED | COMPLETED | CANCELLED | RETURNED

  userId        String?   @map("user_id") // creator; null when synced from a channel
  user          User?     @relation("OrderCreatedBy", fields: [userId], references: [id])
  assigneeId    String?   @map("assignee_id") // person in charge; required past DRAFT / PENDING_CONFIRMATION (SQL CHECK)
  assignee      User?     @relation("OrderAssignee", fields: [assigneeId], references: [id])
  confirmedById String?   @map("confirmed_by")
  confirmedBy   User?     @relation("OrderConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime? @map("confirmed_at") @db.Timestamptz(6)

  channel         String        @default("MANUAL") // MANUAL (created by staff, at the counter or not) | SHOPEE
  channelId       String?       @map("channel_id")
  salesChannel    SalesChannel? @relation(fields: [channelId], references: [id])
  channelOrderRef String?       @map("channel_order_ref") // Shopee order_sn
  channelStatus   String?       @map("channel_status") // the platform's own status, as last synced
  channelPayload  Json?         @map("channel_payload") // raw order as received, for audit/resync
  channelSyncedAt DateTime?     @map("channel_synced_at") @db.Timestamptz(6)
  shipByDate      DateTime?     @map("ship_by_date") @db.Timestamptz(6) // platform hand-over deadline

  fulfillmentType String @default("HOME_DELIVERY") @map("fulfillment_type") // TAKEAWAY | STORE_PICKUP | HOME_DELIVERY

  // grandTotal = subtotal - (discountType = ORDER ? discountValue : 0) + shippingFee (prices VAT-inclusive);
  // a PROMOTION discount is already inside the lines' discountAmount, discountValue only records it
  subtotal        Decimal  @default(0) @db.Decimal(14, 2)
  shippingFee     Decimal  @default(0) @map("shipping_fee") @db.Decimal(14, 2) // charged to the customer
  channelFee      Decimal  @default(0) @map("channel_fee") @db.Decimal(14, 2) // kept by the marketplace (commission, payment fee...) - for margin reports
  vatTotal        Decimal  @default(0) @map("vat_total") @db.Decimal(14, 2)
  grandTotal      Decimal  @map("grand_total") @db.Decimal(14, 2)
  depositRequired Decimal? @map("deposit_required") @db.Decimal(14, 2)
  discountType    String?  @map("discount_type") // ORDER | PROMOTION
  discountValue   Decimal  @default(0) @map("discount_value") @db.Decimal(14, 2)

  paymentStatus String @default("UNPAID") @map("payment_status") // derived from Payment: UNPAID | PARTIALLY_PAID | PAID | PARTIALLY_REFUNDED | REFUNDED

  // TAKEAWAY single payment only
  paymentMethod      String?  @map("payment_method") // CASH | BANK_TRANSFER | SEPAY
  paymentReference   String?  @unique @map("payment_reference")
  sepayTransactionId String?  @map("sepay_transaction_id")
  customerPay        Decimal? @map("customer_pay") @db.Decimal(14, 2)
  change             Decimal? @db.Decimal(14, 2)

  recipientName         String?   @map("recipient_name")
  recipientPhone        String?   @map("recipient_phone")
  deliveryAddress       String?   @map("delivery_address")
  requestedDeliveryDate DateTime? @map("requested_delivery_date") @db.Date

  note      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items             OrderItem[]
  appliedPromotions OrderAppliedPromotion[]
  cashFlows         CashFlow[]
  promotionLogs     PromotionLog[]
  payments          Payment[]
  fulfillments      Fulfillment[]
  shipments         Shipment[]
  invoices          Invoice[]
  returns           OrderReturn[]
  voucherCodesUsed  VoucherCode[]

  @@unique([channelId, channelOrderRef])
  @@index([tenantId, status])
  @@index([tenantId, assigneeId, status])
  @@index([tenantId, branchId, createdAt])
  @@index([tenantId, customerId, createdAt])
  @@index([tenantId, channel, createdAt])
  @@map("orders")
}

model OrderItem {
  id            String      @id @default(uuid())
  orderId       String      @map("order_id")
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productItemId String      @map("product_item_id")
  productItem   ProductItem @relation(fields: [productItemId], references: [id])
  status        String      @default("PENDING") // PENDING | WAITING_STOCK | READY | PACKED | DELIVERED | CANCELLED | RETURNED

  sourceLocationId String?   @map("source_location_id") // expected ship-from; drives the shortage alert
  sourceLocation   Location? @relation("OrderItemSourceLocation", fields: [sourceLocationId], references: [id])

  // PRODUCT | COMBO (priced, no stock) | COMBO_COMPONENT (stock line, price 0) | SERVICE
  lineType     String      @default("PRODUCT") @map("line_type")
  parentItemId String?     @map("parent_item_id") // the COMBO line of a COMBO_COMPONENT
  parentItem   OrderItem?  @relation("OrderItemComboParent", fields: [parentItemId], references: [id], onDelete: Cascade)
  childItems   OrderItem[] @relation("OrderItemComboParent")

  channelItemRef String? @map("channel_item_ref") // the platform's own line id

  // Snapshot
  productName   String?  @map("product_name")
  sku           String?
  variantLabel  String?  @map("variant_label") // e.g. "Gỗ sồi / 1m8"
  listUnitPrice Decimal  @map("list_unit_price") @db.Decimal(12, 2) // SKU retail price at sale time
  unitCostPrice Decimal? @map("unit_cost_price") @db.Decimal(12, 2) // actual average cost of the units packed (Σ SALE ledger rows × lot.unitCost / quantity); null until packed
  vatRate       Decimal? @map("vat_rate") @db.Decimal(5, 2)

  quantity         Int
  unitPrice        Decimal @map("unit_price") @db.Decimal(12, 2) // agreed price (custom may differ from list)
  discountAmount   Decimal @default(0) @map("discount_amount") @db.Decimal(12, 2)
  lineTotal        Decimal @map("line_total") @db.Decimal(14, 2) // unitPrice * quantity - discountAmount
  returnedQuantity Int     @default(0) @map("returned_quantity") // cache of Σ OrderReturnItem

  isCustom      Boolean                 @default(false) @map("is_custom") // made to order; only ever reserved for this line
  customization OrderItemCustomization?

  stockReservations      StockReservation[]
  productionRequestItems ProductionRequestItem[]
  fulfillmentItems       FulfillmentItem[]
  returnItems            OrderReturnItem[]
  invoiceLines           InvoiceLine[]
  customLots             InventoryLot[]          @relation("InventoryLotCustomFor")
  inventoryTransactions  InventoryTransaction[]

  @@index([orderId])
  @@index([productItemId])
  @@index([sourceLocationId, status])
  @@map("order_items")
}

model StockReservation {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  orderItemId String    @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  locationId  String    @map("location_id")
  location    Location  @relation(fields: [locationId], references: [id])
  quantity    Int
  status      String    @default("ACTIVE") // ACTIVE | CONSUMED (line packed, stock deducted) | RELEASED

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, locationId, status])
  @@index([orderItemId])
  @@map("stock_reservations")
}

/// "Yêu cầu sản xuất" sent to a WORKSHOP supplier; goods come back through an IMPORT.
model ProductionRequest {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  code       String // e.g. YCSX000123, quoted when calling the workshop
  supplierId String   @map("supplier_id") // the workshop
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  locationId String   @map("location_id") // where the goods are to be delivered
  location   Location @relation(fields: [locationId], references: [id])
  status     String   @default("DRAFT") // DRAFT | SENT | PARTIALLY_RECEIVED | COMPLETED | CANCELLED

  expectedReadyDate DateTime? @map("expected_ready_date") @db.Date
  sentAt            DateTime? @map("sent_at") @db.Timestamptz(6)
  note              String?

  createdById       String?   @map("created_by")
  createdBy         User?     @relation("ProductionRequestCreatedBy", fields: [createdById], references: [id])
  statusUpdatedById String?   @map("status_updated_by")
  statusUpdatedBy   User?     @relation("ProductionRequestStatusUpdatedBy", fields: [statusUpdatedById], references: [id])
  statusUpdatedAt   DateTime? @map("status_updated_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items ProductionRequestItem[]

  @@unique([tenantId, code])
  @@index([tenantId, status, expectedReadyDate])
  @@index([tenantId, locationId, status])
  @@map("production_requests")
}

/// On import: reserve for orderItem first, then WAITING_STOCK lines by confirmedAt.
model ProductionRequestItem {
  id                  String            @id @default(uuid())
  productionRequestId String            @map("production_request_id")
  productionRequest   ProductionRequest @relation(fields: [productionRequestId], references: [id], onDelete: Cascade)
  productItemId       String            @map("product_item_id")
  productItem         ProductItem       @relation(fields: [productItemId], references: [id])
  orderItemId         String?           @map("order_item_id") // required for a custom line
  orderItem           OrderItem?        @relation(fields: [orderItemId], references: [id])
  quantity            Int
  receivedQuantity    Int               @default(0) @map("received_quantity")
  note                String?

  importLines StockMovementRequestItem[]
  lots        InventoryLot[]

  @@index([productionRequestId])
  @@index([productItemId])
  @@index([orderItemId])
  @@map("production_request_items")
}

/// Specs of a custom line; locked once its production request is SENT.
model OrderItemCustomization {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  orderItemId String    @unique @map("order_item_id")
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  lengthCm       Decimal? @map("length_cm") @db.Decimal(10, 2)
  widthCm        Decimal? @map("width_cm") @db.Decimal(10, 2)
  heightCm       Decimal? @map("height_cm") @db.Decimal(10, 2)
  material       String?
  color          String?
  fabricCode     String?  @map("fabric_code")
  note           String?
  attachmentUrls String[] @map("attachment_urls") // reference photos / sketches

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  specs OrderItemSpec[]

  @@map("order_item_customizations")
}

model OrderItemSpec {
  id              String                 @id @default(uuid())
  customizationId String                 @map("customization_id")
  customization   OrderItemCustomization @relation(fields: [customizationId], references: [id], onDelete: Cascade)
  name            String
  value           String
  unit            String?
  position        Int                    @default(0)

  @@map("order_item_specs")
}

/// "Đơn hoàn hàng".
model OrderReturn {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  code       String
  orderId    String    @map("order_id")
  order      Order     @relation(fields: [orderId], references: [id])
  shipmentId String?   @map("shipment_id") // the failed delivery, when that is the cause
  shipment   Shipment? @relation(fields: [shipmentId], references: [id])
  reason     String // CUSTOMER_RETURN | DELIVERY_FAILED
  status     String    @default("PENDING") // PENDING | INSPECTED | CANCELLED
  note       String?

  createdById   String?   @map("created_by")
  createdBy     User?     @relation("OrderReturnCreatedBy", fields: [createdById], references: [id])
  inspectedById String?   @map("inspected_by")
  inspectedBy   User?     @relation("OrderReturnInspectedBy", fields: [inspectedById], references: [id])
  inspectedAt   DateTime? @map("inspected_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  items OrderReturnItem[]

  @@unique([tenantId, code])
  @@index([tenantId, orderId])
  @@index([tenantId, status])
  @@map("order_returns")
}

/// GOOD -> sellable location; DAMAGED (and any custom piece) -> a location with isSellable = false.
model OrderReturnItem {
  id          String      @id @default(uuid())
  returnId    String      @map("return_id")
  orderReturn OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId String      @map("order_item_id")
  orderItem   OrderItem   @relation(fields: [orderItemId], references: [id])
  quantity    Int
  condition   String? // GOOD | DAMAGED - set at inspection
  locationId  String?     @map("location_id") // where it was put away
  location    Location?   @relation(fields: [locationId], references: [id])
  note        String?

  @@unique([returnId, orderItemId])
  @@map("order_return_items")
}

model OrderAppliedPromotion {
  id             String     @id @default(uuid())
  orderId        String     @map("order_id")
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promotionId    String?    @map("promotion_id")
  promotion      Promotion? @relation(fields: [promotionId], references: [id])
  promoName      String?    @map("promo_name")
  discountAmount Decimal?   @map("discount_amount") @db.Decimal(12, 2)

  @@map("order_applied_promotions")
}

model Promotion {
  id                String   @id @default(uuid())
  tenantId          String   @map("tenant_id")
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  promoName         String   @map("promo_name")
  description       String?
  discountType      String   @map("discount_type") // PERCENT | FIXED_AMOUNT
  discountValue     Decimal  @map("discount_value") @db.Decimal(12, 2)
  maxDiscountAmount Decimal? @map("max_discount_amount") @db.Decimal(12, 2) // PERCENT only
  minOrderValue     Decimal  @default(0) @map("min_order_value") @db.Decimal(12, 2)

  applicableRuleType String @map("applicable_rule_type") // all | category | product

  startDate             DateTime @map("start_date") @db.Timestamptz(6)
  endDate               DateTime @map("end_date") @db.Timestamptz(6)
  stackable             Boolean  @default(false)
  usageLimit            Int?     @map("usage_limit")
  usageLimitPerCustomer Int?     @map("usage_limit_per_customer")
  usedCount             Int      @default(0) @map("used_count")
  status                String   @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  branches          PromotionBranch[]
  ruleCategories    PromotionCategory[]
  ruleProductItems  PromotionProductItem[]
  orderApplications OrderAppliedPromotion[]
  logs              PromotionLog[]
  vouchers          Voucher[]

  @@index([tenantId, status])
  @@index([tenantId, startDate, endDate])
  @@map("promotions")
}

model PromotionBranch {
  promotionId String    @map("promotion_id")
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  branchId    String    @map("branch_id")
  branch      Branch    @relation(fields: [branchId], references: [id])

  @@id([promotionId, branchId])
  @@map("promotion_branches")
}

model PromotionCategory {
  promotionId String    @map("promotion_id")
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  categoryId  String    @map("category_id")
  category    Category  @relation(fields: [categoryId], references: [id])

  @@id([promotionId, categoryId])
  @@map("promotion_categories")
}

model PromotionProductItem {
  promotionId   String      @map("promotion_id")
  promotion     Promotion   @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  productItemId String      @map("product_item_id")
  productItem   ProductItem @relation(fields: [productItemId], references: [id])

  @@id([promotionId, productItemId])
  @@map("promotion_product_items")
}

model PromotionLog {
  id             String    @id @default(uuid())
  tenantId       String    @map("tenant_id")
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  promotionId    String    @map("promotion_id")
  promotion      Promotion @relation(fields: [promotionId], references: [id])
  orderId        String?   @map("order_id")
  order          Order?    @relation(fields: [orderId], references: [id])
  branchId       String?   @map("branch_id")
  branch         Branch?   @relation(fields: [branchId], references: [id])
  customerId     String?   @map("customer_id")
  customer       Customer? @relation(fields: [customerId], references: [id])
  discountAmount Decimal   @map("discount_amount") @db.Decimal(12, 2)
  createdById    String?   @map("created_by")
  createdBy      User?     @relation(fields: [createdById], references: [id])
  description    String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([orderId, promotionId])
  @@index([tenantId, promotionId, createdAt])
  @@map("promotion_logs")
}

model CashDrawerSession {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  branchId       String   @map("branch_id")
  branch         Branch   @relation(fields: [branchId], references: [id])
  businessDate   DateTime @map("business_date") @db.Date // local (Vietnam) trading day
  status         String   @default("OPEN") // OPEN | CLOSED
  openingAmount  Decimal  @map("opening_amount") @db.Decimal(14, 2)
  openedById     String   @map("opened_by")
  openedBy       User     @relation("CashDrawerOpenedBy", fields: [openedById], references: [id])
  currentStaffId String   @map("current_staff_id")
  currentStaff   User     @relation("CashDrawerCurrentStaff", fields: [currentStaffId], references: [id])

  finalLogAmount    Decimal? @map("final_log_amount") @db.Decimal(14, 2)
  finalLogManagerId String?  @map("final_log_manager_id")
  finalLogManager   User?    @relation("CashDrawerFinalLogManager", fields: [finalLogManagerId], references: [id])
  finalLogNote      String?  @map("final_log_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  shiftLogs CashDrawerShiftLog[]

  @@unique([tenantId, branchId, businessDate]) // one OPEN per branch is a partial index (see header)
  @@map("cash_drawer_sessions")
}

model CashDrawerShiftLog {
  id          String            @id @default(uuid())
  sessionId   String            @map("session_id")
  session     CashDrawerSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type        String            @default("END") // START | END
  staffId     String            @map("staff_id")
  staff       User              @relation("ShiftLogStaff", fields: [staffId], references: [id])
  amount      Decimal           @db.Decimal(14, 2)
  nextStaffId String?           @map("next_staff_id")
  nextStaff   User?             @relation("ShiftLogNextStaff", fields: [nextStaffId], references: [id])
  note        String?
  loggedAt    DateTime          @default(now()) @map("logged_at") @db.Timestamptz(6)

  @@map("cash_drawer_shift_logs")
}

/// Cash ledger, written only by money events, never through a route.
model CashFlow {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  tenant             Tenant    @relation(fields: [tenantId], references: [id])
  flowType           String    @map("flow_type") // INCOME | EXPENSE
  amount             Decimal   @db.Decimal(14, 2)
  paymentMethod      String?   @map("payment_method") // CASH | BANK_TRANSFER | SEPAY
  locationId         String?   @map("location_id")
  location           Location? @relation(fields: [locationId], references: [id])
  paymentId          String?   @unique @map("payment_id")
  payment            Payment?  @relation(fields: [paymentId], references: [id])
  orderId            String?   @map("order_id")
  order              Order?    @relation(fields: [orderId], references: [id])
  supplierId         String?   @map("supplier_id")
  supplier           Supplier? @relation(fields: [supplierId], references: [id])
  createdById        String?   @map("created_by")
  createdBy          User?     @relation(fields: [createdById], references: [id])
  paymentReference   String?   @map("payment_reference")
  sepayTransactionId String?   @map("sepay_transaction_id")
  description        String?
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, createdAt])
  @@index([tenantId, locationId, createdAt])
  @@index([tenantId, orderId])
  @@map("cash_flows")
}

/// A PAID row writes exactly one CashFlow.
model Payment {
  id       String @id @default(uuid())
  tenantId String @map("tenant_id")
  tenant   Tenant @relation(fields: [tenantId], references: [id])
  orderId  String @map("order_id")
  order    Order  @relation(fields: [orderId], references: [id])

  method String // CASH | BANK_TRANSFER | SEPAY | CHANNEL (collected by the marketplace, paid out later)
  kind   String // FULL | DEPOSIT | BALANCE | REFUND
  amount Decimal @db.Decimal(14, 2) // always positive; REFUND = money out
  status String  @default("PENDING") // PENDING | PAID | FAILED | CANCELLED

  refundOfPaymentId String?   @map("refund_of_payment_id")
  refundOf          Payment?  @relation("PaymentRefund", fields: [refundOfPaymentId], references: [id])
  refunds           Payment[] @relation("PaymentRefund")

  paymentReference   String?   @unique @map("payment_reference") // code the customer puts in the transfer
  sepayTransactionId String?   @map("sepay_transaction_id")
  paidAt             DateTime? @map("paid_at") @db.Timestamptz(6)

  locationId    String?   @map("location_id")
  location      Location? @relation(fields: [locationId], references: [id])
  collectedById String?   @map("collected_by")
  collectedBy   User?     @relation("PaymentCollectedBy", fields: [collectedById], references: [id])

  createdById String?  @map("created_by")
  createdBy   User?    @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  note        String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  cashFlow CashFlow?

  @@index([tenantId, orderId])
  @@index([tenantId, status, createdAt])
  @@map("payments")
}

// ─────────────────────────────────────────────────────────────────────────
// F2. Fulfillment & delivery
// ─────────────────────────────────────────────────────────────────────────

/// Packs READY lines. Packing a line consumes its reservation and deducts the stock (from lots);
/// HANDED_OVER only records the hand-over to the carrier.
model Fulfillment {
  id         String   @id @default(uuid())
  tenantId   String   @map("tenant_id")
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  orderId    String   @map("order_id")
  order      Order    @relation(fields: [orderId], references: [id])
  locationId String   @map("location_id")
  location   Location @relation(fields: [locationId], references: [id])

  // PENDING | PICKING | PICKED | PACKING | PACKED | HANDED_OVER | EXCEPTION | CANCELLED
  status        String  @default("PENDING")
  exceptionNote String? @map("exception_note")

  assigneeId   String? @map("assignee_id")
  assignee     User?   @relation("FulfillmentAssignee", fields: [assigneeId], references: [id])
  verifiedById String? @map("verified_by") // person in charge confirms the goods are intact before they leave
  verifiedBy   User?   @relation("FulfillmentVerifiedBy", fields: [verifiedById], references: [id])

  dueDate       DateTime? @map("due_date") @db.Date
  pickStartedAt DateTime? @map("pick_started_at") @db.Timestamptz(6)
  pickedAt      DateTime? @map("picked_at") @db.Timestamptz(6)
  packStartedAt DateTime? @map("pack_started_at") @db.Timestamptz(6)
  packedAt      DateTime? @map("packed_at") @db.Timestamptz(6)
  verifiedAt    DateTime? @map("verified_at") @db.Timestamptz(6)
  handedOverAt  DateTime? @map("handed_over_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  items     FulfillmentItem[]
  packages  FulfillmentPackage[]
  shipments Shipment[]

  @@index([tenantId, locationId, status])
  @@index([tenantId, orderId])
  @@index([tenantId, assigneeId, status])
  @@map("fulfillments")
}

model FulfillmentItem {
  id            String       @id @default(uuid())
  fulfillmentId String       @map("fulfillment_id")
  fulfillment   Fulfillment  @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItemId   String       @map("order_item_id")
  orderItem     OrderItem    @relation(fields: [orderItemId], references: [id])
  quantity      Int
  qtyPicked     Int          @default(0) @map("qty_picked")
  qtyPacked     Int          @default(0) @map("qty_packed") // stock is deducted as units are packed
  pickedFromId  String?      @map("picked_from_id")
  pickedFrom    StorageNode? @relation(fields: [pickedFromId], references: [id])

  @@unique([fulfillmentId, orderItemId])
  @@map("fulfillment_items")
}

model FulfillmentPackage {
  id               String          @id @default(uuid())
  tenantId         String          @map("tenant_id")
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  fulfillmentId    String          @map("fulfillment_id")
  fulfillment      Fulfillment     @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  code             String
  productPackageId String?         @map("product_package_id")
  productPackage   ProductPackage? @relation(fields: [productPackageId], references: [id])
  weightKg         Decimal?        @map("weight_kg") @db.Decimal(10, 3)
  photoUrls        String[]        @map("photo_urls")
  packedById       String?         @map("packed_by")
  packedBy         User?           @relation(fields: [packedById], references: [id])
  packedAt         DateTime        @default(now()) @map("packed_at") @db.Timestamptz(6)
  handedOverAt     DateTime?       @map("handed_over_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@index([fulfillmentId])
  @@map("fulfillment_packages")
}

/// EXTERNAL: carrier/platform reports DELIVERED. INTERNAL: shipper confirms with proof photos.
model Shipment {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  tenant        Tenant      @relation(fields: [tenantId], references: [id])
  orderId       String      @map("order_id")
  order         Order       @relation(fields: [orderId], references: [id])
  fulfillmentId String      @map("fulfillment_id")
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id])

  carrierType  String  @default("INTERNAL") @map("carrier_type") // INTERNAL | EXTERNAL
  carrierName  String? @map("carrier_name")
  trackingCode String? @map("tracking_code")
  driverId     String? @map("driver_id")
  driver       User?   @relation("ShipmentDriver", fields: [driverId], references: [id])

  // CREATED | PICKED_UP | IN_TRANSIT | OUT_FOR_DELIVERY | DELIVERED | FAILED | RETURNED | CANCELLED
  status String @default("CREATED")

  recipientName   String? @map("recipient_name")
  recipientPhone  String? @map("recipient_phone")
  deliveryAddress String? @map("delivery_address")

  scheduledDate      DateTime? @map("scheduled_date") @db.Date
  scheduledSlot      String?   @map("scheduled_slot") // e.g. "08:00-12:00"
  expectedDeliveryAt DateTime? @map("expected_delivery_at") @db.Timestamptz(6)
  deliveredAt        DateTime? @map("delivered_at") @db.Timestamptz(6)

  requiresInstallation Boolean   @default(false) @map("requires_installation")
  installedAt          DateTime? @map("installed_at") @db.Timestamptz(6)

  proofPhotoUrls String[] @map("proof_photo_urls")
  shippingCost   Decimal? @map("shipping_cost") @db.Decimal(14, 2) // what the carrier charges us (≠ Order.shippingFee)
  note           String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  events  ShipmentEvent[]
  returns OrderReturn[]

  @@unique([carrierName, trackingCode])
  @@index([tenantId, status, expectedDeliveryAt])
  @@index([tenantId, carrierName])
  @@index([tenantId, orderId])
  @@index([fulfillmentId])
  @@map("shipments")
}

model ShipmentEvent {
  id          String   @id @default(uuid())
  shipmentId  String   @map("shipment_id")
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  status      String
  source      String   @default("MANUAL") // MANUAL | CARRIER
  note        String?
  latitude    Float?
  longitude   Float?
  createdById String?  @map("created_by")
  createdBy   User?    @relation(fields: [createdById], references: [id])
  occurredAt  DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([shipmentId, occurredAt])
  @@map("shipment_events")
}

model OperationEvent {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  tenant        Tenant    @relation(fields: [tenantId], references: [id])
  locationId    String?   @map("location_id")
  location      Location? @relation(fields: [locationId], references: [id])
  userId        String    @map("user_id")
  user          User      @relation(fields: [userId], references: [id])
  type          String // PICK_STARTED | PICK_DONE | PACK_STARTED | PACK_DONE | SCAN_OK | SCAN_FAIL | VERIFY_OK | VERIFY_FAIL | HANDED_OVER | ...
  referenceType String?   @map("reference_type") // FULFILLMENT | STOCK_MOVEMENT | SHIPMENT
  referenceId   String?   @map("reference_id")
  metadata      Json?
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@index([tenantId, userId, occurredAt])
  @@index([tenantId, locationId, occurredAt])
  @@index([referenceType, referenceId])
  @@map("operation_events")
}

// ─────────────────────────────────────────────────────────────────────────
// F3. Vouchers & invoices (customers are reference data in section C)
// ─────────────────────────────────────────────────────────────────────────

model Voucher {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  promotionId String    @map("promotion_id")
  promotion   Promotion @relation(fields: [promotionId], references: [id])
  name        String
  codePrefix  String?   @map("code_prefix")
  status      String    @default("ACTIVE") // ACTIVE | INACTIVE
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  codes VoucherCode[]

  @@map("vouchers")
}

model VoucherCode {
  id         String    @id @default(uuid())
  tenantId   String    @map("tenant_id")
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  voucherId  String    @map("voucher_id")
  voucher    Voucher   @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  code       String
  customerId String?   @map("customer_id") // null = anyone holding the code
  customer   Customer? @relation(fields: [customerId], references: [id])
  status     String    @default("AVAILABLE") // AVAILABLE | ISSUED | USED | EXPIRED | REVOKED
  orderId    String?   @map("order_id")
  order      Order?    @relation(fields: [orderId], references: [id])
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, code])
  @@index([tenantId, customerId, status])
  @@map("voucher_codes")
}

/// Never edited once issued; a refund issues an ADJUSTMENT.
model Invoice {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  orderId           String    @map("order_id")
  order             Order     @relation(fields: [orderId], references: [id])
  invoiceNumber     String    @map("invoice_number")
  type              String    @default("SALE") // SALE | ADJUSTMENT
  originalInvoiceId String?   @map("original_invoice_id")
  originalInvoice   Invoice?  @relation("InvoiceAdjustment", fields: [originalInvoiceId], references: [id])
  adjustments       Invoice[] @relation("InvoiceAdjustment")
  status            String    @default("ISSUED") // DRAFT | ISSUED | CANCELLED

  buyerName    String? @map("buyer_name")
  buyerTaxCode String? @map("buyer_tax_code")
  buyerAddress String? @map("buyer_address")

  subtotal  Decimal   @db.Decimal(14, 2)
  vatAmount Decimal   @default(0) @map("vat_amount") @db.Decimal(14, 2)
  total     Decimal   @db.Decimal(14, 2) // negative for a refunding ADJUSTMENT
  reason    String? // required for ADJUSTMENT
  issuedAt  DateTime? @map("issued_at") @db.Timestamptz(6)

  einvoiceProvider   String? @map("einvoice_provider")
  einvoiceRef        String? @map("einvoice_ref")
  einvoiceLookupCode String? @map("einvoice_lookup_code")

  createdById String?  @map("created_by")
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  lines InvoiceLine[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId, orderId])
  @@map("invoices")
}

model InvoiceLine {
  id          String     @id @default(uuid())
  invoiceId   String     @map("invoice_id")
  invoice     Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  orderItemId String?    @map("order_item_id")
  orderItem   OrderItem? @relation(fields: [orderItemId], references: [id])
  description String // name + variant + short custom spec
  quantity    Int
  unitPrice   Decimal    @map("unit_price") @db.Decimal(12, 2)
  vatRate     Decimal    @default(0) @map("vat_rate") @db.Decimal(5, 2)
  amount      Decimal    @db.Decimal(14, 2)
  position    Int        @default(0)

  @@index([invoiceId])
  @@map("invoice_lines")
}

// ─────────────────────────────────────────────────────────────────────────
// G. Comms & misc
// ─────────────────────────────────────────────────────────────────────────

model Notification {
  id          String   @id @default(uuid())
  title       String
  description String
  type        String
  tenantId    String?  @map("tenant_id")
  tenant      Tenant?  @relation(fields: [tenantId], references: [id])
  recipientId String?  @map("recipient_id")
  recipient   User?    @relation("NotificationRecipient", fields: [recipientId], references: [id])
  link        String?
  category    String? // ANNOUNCEMENT only
  targetType  String?  @map("target_type") // ALL | SELECTION - ANNOUNCEMENT only
  createdById String?  @map("created_by")
  createdBy   User?    @relation("NotificationCreatedBy", fields: [createdById], references: [id])
  referenceId String?  @map("reference_id")
  isRead      Boolean  @default(false) @map("is_read")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  targetTenants NotificationTargetTenant[]

  @@index([recipientId, createdAt])
  @@index([recipientId, isRead])
  @@index([tenantId, createdAt])
  @@map("notifications")
}

model NotificationTargetTenant {
  notificationId String       @map("notification_id")
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  tenantId       String       @map("tenant_id")
  tenant         Tenant       @relation(fields: [tenantId], references: [id])

  @@id([notificationId, tenantId])
  @@map("notification_target_tenants")
}

model Ticket {
  id                String    @id @default(uuid())
  ticketId          String    @unique @map("ticket_id") // human-readable code
  tenantId          String    @map("tenant_id")
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  tenantName        String    @map("tenant_name") // denormalized
  userId            String    @map("user_id")
  user              User      @relation(fields: [userId], references: [id])
  title             String
  description       String
  priority          String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status            String    @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  isDeletedByTenant Boolean   @default(false) @map("is_deleted_by_tenant")
  deletedAt         DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  messages TicketMessage[]

  @@map("tickets")
}

model TicketMessage {
  id         String   @id @default(uuid())
  ticketId   String   @map("ticket_id")
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String   @map("sender_id")
  sender     User     @relation(fields: [senderId], references: [id])
  senderName String   @map("sender_name")
  senderRole String   @map("sender_role")
  message    String
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ticket_messages")
}

model AIChatHistory {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])
  title     String   @default("Cuộc hội thoại mới")
  messages  Json     @default("[]") // [{ role, parts: [{ text }], createdAt }]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("ai_chat_histories")
}
