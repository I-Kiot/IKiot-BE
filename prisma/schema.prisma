model ShiftTemplate {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  name      String?
  startTime DateTime? @map("start_time") @db.Time
  endTime   DateTime? @map("end_time") @db.Time // may be before startTime (night shift)
  status    String    @default("ACTIVE") // ACTIVE | DELETED
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  workingSchedules WorkingSchedule[]

  @@map("shift_templates")
}

model WorkingSchedule {
  id              String         @id @default(uuid())
  tenantId        String         @map("tenant_id")
  tenant          Tenant         @relation(fields: [tenantId], references: [id])
  locationId      String?        @map("location_id")
  location        Location?      @relation(fields: [locationId], references: [id])
  managedById     String?        @map("managed_by")
  managedBy       User?          @relation("WorkingScheduleManagedBy", fields: [managedById], references: [id])
  scheduleType    String         @default("NORMAL") @map("schedule_type") // NORMAL | OVERTIME
  shiftTemplateId String?        @map("shift_template_id")
  shiftTemplate   ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id])
  createdById     String?        @map("created_by")
  createdBy       User?          @relation("WorkingScheduleCreatedBy", fields: [createdById], references: [id])
  workDate        DateTime?      @map("work_date") @db.Date
  startAt         DateTime?      @map("start_at") @db.Timestamptz(6)
  endAt           DateTime?      @map("end_at") @db.Timestamptz(6)
  status          String         @default("SCHEDULED") // SCHEDULED | COMPLETED | CANCELLED | DELETED
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  assignedUsers         WorkingScheduleUser[]
  attendances           Attendance[]
  handoverLeaveRequests LeaveRequestHandoverSchedule[]

  @@index([tenantId, locationId, workDate])
  @@map("working_schedules")
}

model WorkingScheduleUser {
  scheduleId String          @map("schedule_id")
  schedule   WorkingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  userId     String          @map("user_id")
  user       User            @relation(fields: [userId], references: [id])

  @@id([scheduleId, userId])
  @@map("working_schedule_users")
}

model Attendance {
  id               String          @id @default(uuid())
  tenantId         String          @map("tenant_id")
  tenant           Tenant          @relation(fields: [tenantId], references: [id])
  userId           String          @map("user_id")
  user             User            @relation("AttendanceUser", fields: [userId], references: [id])
  scheduleId       String          @map("schedule_id")
  schedule         WorkingSchedule @relation(fields: [scheduleId], references: [id])
  workDate         DateTime        @map("work_date") @db.Date
  actualCheckinAt  DateTime?       @map("actual_checkin_at") @db.Timestamptz(6)
  actualCheckoutAt DateTime?       @map("actual_checkout_at") @db.Timestamptz(6)
  workedMinutes    Int?            @map("worked_minutes")
  overtimeMinute   Int?            @map("overtime_minute")
  lateMinutes      Int?            @map("late_minutes")
  status           String? // CHECKED_IN | CHECKED_OUT | ABSENT

  checkInLatitude           Float?  @map("check_in_latitude")
  checkInLongitude          Float?  @map("check_in_longitude")
  checkInAccuracy           Float?  @map("check_in_accuracy")
  checkInDistance           Float?  @map("check_in_distance")
  checkInVerificationStatus String? @default("VERIFIED") @map("check_in_verification_status") // VERIFIED | LOW_ACCURACY | OUT_OF_RANGE | NO_LOCATION

  checkOutLatitude           Float?  @map("check_out_latitude")
  checkOutLongitude          Float?  @map("check_out_longitude")
  checkOutAccuracy           Float?  @map("check_out_accuracy")
  checkOutDistance           Float?  @map("check_out_distance")
  checkOutVerificationStatus String? @default("VERIFIED") @map("check_out_verification_status")

  manuallyEditedById   String?   @map("manually_edited_by")
  manuallyEditedBy     User?     @relation("AttendanceManuallyEditedBy", fields: [manuallyEditedById], references: [id])
  manuallyEditedAt     DateTime? @map("manually_edited_at") @db.Timestamptz(6)
  manualEditReason     String?   @map("manual_edit_reason")
  manuallyCreatedById  String?   @map("manually_created_by")
  manuallyCreatedBy    User?     @relation("AttendanceManuallyCreatedBy", fields: [manuallyCreatedById], references: [id])
  manuallyCreatedAt    DateTime? @map("manually_created_at") @db.Timestamptz(6)
  manualCreationReason String?   @map("manual_creation_reason")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([userId, scheduleId])
  @@index([tenantId, userId, workDate])
  @@index([tenantId, userId, status])
  @@map("attendances")
}

model LeaveRequest {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  tenant           Tenant    @relation(fields: [tenantId], references: [id])
  userId           String    @map("user_id")
  user             User      @relation("LeaveRequestUser", fields: [userId], references: [id])
  approvedById     String?   @map("approved_by")
  approvedBy       User?     @relation("LeaveRequestApprovedBy", fields: [approvedById], references: [id])
  paidLeaveDays    Decimal   @default(0) @map("paid_leave_days") @db.Decimal(5, 2)
  unpaidLeaveDays  Decimal   @default(0) @map("unpaid_leave_days") @db.Decimal(5, 2)
  startDate        DateTime? @map("start_date") @db.Date
  endDate          DateTime? @map("end_date") @db.Date
  status           String? // PENDING | APPROVED | REJECTED | CANCELLED | EXPIRED | DELETED
  reason           String?
  reviewNote       String?   @map("review_note")
  handoverToUserId String?   @map("handover_to_user_id")
  handoverToUser   User?     @relation("LeaveRequestHandoverTo", fields: [handoverToUserId], references: [id])
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  handoverSchedules LeaveRequestHandoverSchedule[]
  payslipLeaveLines PayslipLeaveLine[]

  @@map("leave_requests")
}

model LeaveRequestHandoverSchedule {
  leaveRequestId String          @map("leave_request_id")
  leaveRequest   LeaveRequest    @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)
  scheduleId     String          @map("schedule_id")
  schedule       WorkingSchedule @relation(fields: [scheduleId], references: [id])

  @@id([leaveRequestId, scheduleId])
  @@map("leave_request_handover_schedules")
}

model Holiday {
  id               String   @id @default(uuid())
  tenantId         String   @map("tenant_id")
  tenant           Tenant   @relation(fields: [tenantId], references: [id])
  date             DateTime @db.Date
  name             String
  type             String   @default("PUBLIC_HOLIDAY") // PUBLIC_HOLIDAY | COMPANY_HOLIDAY
  branchId         String?  @map("branch_id")
  branch           Branch?  @relation(fields: [branchId], references: [id])
  isActive         Boolean  @default(true) @map("is_active")
  source           String   @default("MANUAL") // GOOGLE_CALENDAR | MANUAL
  isManuallyEdited Boolean  @default(false) @map("is_manually_edited")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([tenantId, date, branchId, type]) // branch rows only; public holidays use a partial index (see header)
  @@map("holidays")
}

model PayrollSetting {
  id                         String   @id @default(uuid())
  tenantId                   String   @map("tenant_id")
  tenant                     Tenant   @relation(fields: [tenantId], references: [id])
  cycle                      String   @default("MONTHLY")
